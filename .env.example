# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN="24h"
BCRYPT_SALT_ROUNDS="10"

# Application Database Configuration (External Neon PostgreSQL Production Target)
# Production uses external PostgreSQL (Neon) with connection pooling & SSL.
# Local development & testing can use embedded PGlite when DATABASE_URL is not set.
DATABASE_PROVIDER="postgres"
DATABASE_URL=""
PGLITE_DATA_DIR="./data/pgdata"
ALLOW_PGLITE_PRODUCTION="false"

# Optional Connection Pool Tuning
DB_POOL_MAX="20"
DB_POOL_MIN="2"
DB_IDLE_TIMEOUT_MS="10000"
DB_CONNECTION_TIMEOUT_MS="5000"
DB_STATEMENT_TIMEOUT_MS="30000"

# Application Backup & Disaster Recovery Storage
# Default provider is local storage directory. Cloud Storage (GCS) is optional.
BACKUP_STORAGE_PROVIDER="local"
BACKUP_STORAGE_DIR="./data/backups"
# Optional GCS Backup configuration (only required when BACKUP_STORAGE_PROVIDER="gcs"):
# BACKUP_GCS_BUCKET=""
# BACKUP_GCS_PREFIX="ai-business-system/backups"
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# Transactional Email Service Configuration
EMAIL_PROVIDER="mock" # Options: mock, logger, smtp, resend
EMAIL_FROM_ADDRESS="noreply@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_SECURE="false"
RESEND_API_KEY="re_123456789"
EMAIL_RATE_LIMIT_PER_MINUTE="10"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PROVIDER="mock" # Options: mock, meta
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
